# Application
MAILER_PORT=8090

# Database
MAILER_DB_HOST=localhost
MAILER_DB_PORT=5432
MAILER_DB_NAME=football_db
MAILER_DB_USER=football_app
MAILER_DB_PASSWORD=change-me-in-your-local-env

# Polling
MAILER_POLL_INTERVAL_MS=5000
MAILER_BATCH_SIZE=20
MAILER_RETRY_LIMIT=5
MAILER_RETRY_DELAY_SECONDS=60
MAILER_STALE_LOCK_SECONDS=300

# Transport
# Для локальной отладки без реальной отправки оставьте log.
# Для реальной отправки через Яндекс смените на smtp.
MAILER_TRANSPORT_TYPE=log
MAILER_FROM_EMAIL=info@bgfoot.ru
MAILER_FROM_NAME=BGFoot

# Yandex SMTP
# Для Яндекс 360 Business указывайте полный email как логин.
# Пароль должен быть паролем приложения, а не обычным паролем от ящика.
MAILER_SMTP_HOST=smtp.yandex.ru
MAILER_SMTP_PORT=465
MAILER_SMTP_USERNAME=info@bgfoot.ru
MAILER_SMTP_PASSWORD=app-password-from-yandex
MAILER_SMTP_AUTH=true
MAILER_SMTP_SSL_ENABLE=true
MAILER_SMTP_STARTTLS=false
MAILER_SMTP_CONNECTION_TIMEOUT_MS=10000
MAILER_SMTP_TIMEOUT_MS=10000
MAILER_SMTP_WRITE_TIMEOUT_MS=10000
