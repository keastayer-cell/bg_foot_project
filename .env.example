# Local environment only. Copy this file to .env in the repository root.

# Shared database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=football_db
DB_SCHEMA=work
DB_USER=football_app
DB_PASSWORD=121212

# Backend
APP_PROFILE=local
APP_PORT=8080
APP_PUBLIC_WEB_URL=http://127.0.0.1:5173
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=480
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_REFRESH_COOKIE_SECURE=false
APP_SUPER_ADMIN_EMAIL=
MAILER_TRIGGER_ENABLED=true
MAILER_TRIGGER_URL=http://127.0.0.1:8090/internal/notifications/process

# Mailer
MAILER_PORT=8090
MAILER_POLL_INTERVAL_MS=5000
MAILER_BATCH_SIZE=20
MAILER_RETRY_LIMIT=5
MAILER_RETRY_DELAY_SECONDS=60
MAILER_MAX_RETRY_DELAY_SECONDS=3600
MAILER_STALE_LOCK_SECONDS=300
MAILER_TRANSPORT_TYPE=log
MAILER_FROM_EMAIL=no-reply@localhost
MAILER_FROM_NAME=BGFoot Local

# SMTP is unused while MAILER_TRANSPORT_TYPE=log.
MAILER_SMTP_HOST=smtp.example.invalid
MAILER_SMTP_PORT=465
MAILER_SMTP_USERNAME=
MAILER_SMTP_PASSWORD=
MAILER_SMTP_AUTH=true
MAILER_SMTP_SSL_ENABLE=true
MAILER_SMTP_STARTTLS=false
MAILER_SMTP_CONNECTION_TIMEOUT_MS=10000
MAILER_SMTP_TIMEOUT_MS=10000
MAILER_SMTP_WRITE_TIMEOUT_MS=10000
